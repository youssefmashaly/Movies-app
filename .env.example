# GEMINI_API_KEY: Required for the AI Matchmaker feature. Read server-side
# only (see server.ts, getAI()) — never exposed to the client bundle. Get a
# key from https://aistudio.google.com/apikey and set it as an environment
# variable in your hosting provider's dashboard (Render/Vercel/Netlify/etc.),
# or in a local .env file for development. If unset, AI Matchmaker requests
# will fail gracefully rather than crash the server.
GEMINI_API_KEY="your-gemini-api-key"

# AI_CACHE_TTL_MS: Optional. How long (in milliseconds) AI Matchmaker results
# are cached server-side before being regenerated. Defaults to 30 minutes.
AI_CACHE_TTL_MS="1800000"

# PORT: Optional. Port the Express server listens on locally / in a plain
# Node deployment. Most hosting providers (Render, Railway, etc.) set this
# automatically — you typically don't need to set it yourself.
PORT="3000"

# NODE_ENV: Optional. Set to "production" by your hosting provider's build
# process; controls dev-only behavior (e.g. Vite middleware vs. the built
# static bundle, the /api/_diagnostics/cache endpoint). You shouldn't need
# to set this manually outside of local testing.
NODE_ENV="development"

# VITE_SUPABASE_URL: Your Supabase project URL (Project Settings > API).
# Must be prefixed with VITE_ so Vite exposes it to client-side code.
VITE_SUPABASE_URL="https://your-project.supabase.co"

# VITE_SUPABASE_ANON_KEY: Your Supabase project's public anon key (Project Settings > API).
# Safe to expose client-side — Row Level Security policies enforce access control.
VITE_SUPABASE_ANON_KEY="your-anon-key"

# VITE_TMDB_API_KEY: Your TMDB API key (v3 auth), from themoviedb.org/settings/api.
# Used for one-time artwork migration scripts (fetch-tmdb-artwork.mjs) and any
# live TMDB lookups. Must be prefixed with VITE_ to be usable client-side.
VITE_TMDB_API_KEY="your-tmdb-api-key"

# VITE_FIREBASE_API_KEY / VITE_FIREBASE_AUTH_DOMAIN / VITE_FIREBASE_PROJECT_ID /
# VITE_FIREBASE_STORAGE_BUCKET / VITE_FIREBASE_MESSAGING_SENDER_ID / VITE_FIREBASE_APP_ID:
# Firebase project config (Project Settings > General > Your apps).
# Note: Firebase client config values are not secret by Firebase's own security
# model (access control is enforced by Firebase Auth + Security Rules, not by
# hiding these), but they're externalized here for config hygiene — so you can
# swap Firebase projects between environments without touching source code.
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# VITE_ANALYTICS_ENABLED / VITE_ANALYTICS_ENDPOINT: Optional, off by default.
# Enables a minimal built-in analytics beacon (see src/lib/analytics.ts) — no
# third-party SDK, no bundle weight, zero network calls unless both are set.
VITE_ANALYTICS_ENABLED="false"
VITE_ANALYTICS_ENDPOINT=""
